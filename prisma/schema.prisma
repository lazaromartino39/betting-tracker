generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt     @id @default(autoincrement())
  email     String     @unique
  username  String     @unique
  password  String
  name      String?
  avatar    String?
  bio       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  bets      Bet[]
  followers Relationship[] @relation("follower")
  following Relationship[] @relation("following")
  groups    GroupMember[]
  posts     Post[]
  likes     Like[]
}

model Relationship {
  id          BigInt   @id @default(autoincrement())
  followerId  BigInt
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId BigInt
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Group {
  id          BigInt        @id @default(autoincrement())
  name        String
  description String?
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members GroupMember[]
  posts   Post[]
}

model GroupMember {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   BigInt
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
}

model Post {
  id        BigInt   @id @default(autoincrement())
  content   String
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   BigInt?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets  Bet[]
  likes Like[]
}

model Like {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    BigInt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Bet {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId          BigInt?
  post            Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  sport           String
  league          String
  event           String
  eventId         String
  betType         String
  selection       String
  odds            Float
  wagerAmount     Float
  potentialWin    Float

  status          String   @default("pending")
  oddsAtTime      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resultTime      DateTime?
}

model OddsSnapshot {
  id            BigInt   @id @default(autoincrement())
  eventId       String
  sport         String
  league        String
  eventName     String
  startTime     DateTime
  oddsData      String
  createdAt     DateTime @default(now())

  @@index([eventId, createdAt])
}
